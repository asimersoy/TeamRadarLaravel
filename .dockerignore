yarn.lock
pnpm-lock.yaml

# PHP/Laravel
vendor
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache/*.php

# OS cruft
.DS_Store
Thumbs.db

# Tests & local artifacts (optional)
coverage
dist
build

